#!/usr/bin/env bash
#MISE description="Unit + envtest (excludes e2e)"
#MISE depends=["gen", "fmt"]
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
BIN_DIR="$ROOT/bin"
ASSETS="$(setup-envtest use "{{vars.ENVTEST_K8S_VERSION}}" --bin-dir "$BIN_DIR" -p path)"
KUBEBUILDER_ASSETS="$ASSETS" gotestsum --format testdox -- \
  $(go list ./... | grep -v /e2e) -coverprofile cover.out
