#!/usr/bin/env bash
#MISE description="Build manager Docker image"
#USAGE flag "--img <img>" help="Image tag" default="zrok-operator:dev"
set -euo pipefail

IMG="${usage_img:-${IMG:-zrok-operator:dev}}"
echo "Building $IMG"
# --load is required when the default builder is docker-container / buildx:
# without it the build can succeed while the tag never appears in `docker images`
# (Kind then fails with: image not present locally).
if [[ "${GITHUB_ACTIONS:-}" == "true" ]] && docker buildx version >/dev/null 2>&1; then
  docker buildx build --load \
    --cache-from=type=gha \
    --cache-to=type=gha,mode=max,ignore-error=true \
    -t "$IMG" .
else
  docker build --load -t "$IMG" .
fi
docker image inspect "$IMG" >/dev/null
echo "Built $IMG ($(docker image inspect -f '{{.Id}}' "$IMG"))"
