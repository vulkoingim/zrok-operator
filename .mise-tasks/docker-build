#!/usr/bin/env bash
#MISE description="Build manager Docker image (host linux binary + thin image)"
#USAGE flag "--img <img>" help="Image tag" default="zrok-operator:dev"
set -euo pipefail

IMG="${usage_img:-${IMG:-zrok-operator:dev}}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/version.sh
source "$ROOT/.mise-tasks/lib/version.sh"
# shellcheck source=lib/kind-image.sh
source "$ROOT/.mise-tasks/lib/kind-image.sh"

GOARCH="$(kind_target_goarch)"
BINDIR="$ROOT/bin"
BINARY_NAME="manager-linux-${GOARCH}"
mkdir -p "$BINDIR"

echo "Building linux/${GOARCH} manager -> bin/${BINARY_NAME}"
echo "  Version: ${VERSION}"
echo "  Git revision: ${GIT_REVISION}"
echo "  Date: ${DATE}"
(
	cd "$ROOT"
	CGO_ENABLED=0 GOOS=linux GOARCH="$GOARCH" \
		go build -trimpath -buildvcs=true -ldflags "$GOLDFLAGS" -o "${BINDIR}/${BINARY_NAME}" ./cmd
)

ctx="$(mktemp -d)"
trap 'rm -rf "$ctx"' EXIT
cp "${BINDIR}/${BINARY_NAME}" "$ctx/manager"

echo "Building image $IMG from Dockerfile.fast"
docker build --load \
	-f "$ROOT/Dockerfile.fast" \
	-t "$IMG" \
	"$ctx"
docker image inspect "$IMG" >/dev/null
echo "Built $IMG ($(docker image inspect -f '{{.Id}}' "$IMG"))"
